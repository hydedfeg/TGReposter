# GEMINI_API_KEY: Required for Gemini AI API calls.
# AI Studio automatically injects this at runtime from user secrets.
# Users configure this via the Secrets panel in the AI Studio UI.
GEMINI_API_KEY="MY_GEMINI_API_KEY"

# APP_URL: The URL where this applet is hosted.
# AI Studio automatically injects this at runtime with the Cloud Run service URL.
# Used for self-referential links, OAuth callbacks, and API endpoints.
APP_URL="MY_APP_URL"

# SUPABASE_URL: The URL of your Supabase project (e.g. https://xyz.supabase.co).
# To connect to Supabase, create a table named "curator_settings" (see schema instructions).
SUPABASE_URL="

# SUPABASE_ANON_KEY: The public/anon API key of your Supabase project.
SUPABASE_ANON_KEY=

# DATABASE_URL: Optional. The direct PostgreSQL connection URI of your Supabase database.
# If provided, the application can auto-generate and bootstrap tables for you.
# Format: postgresql://postgres:[password]@db.[project-id].supabase.co:5432/postgres
DATABASE_URL=

# OPENROUTER_API_KEY: Optional. The API key for OpenRouter AI to enable alternative LLM models.
# Users configure this via the Secrets panel in the AI Studio UI.
OPENROUTER_API_KEY=

# Crypto payment infrastructure is disabled by default.
# These settings are server-only. Never add wallet private keys or seed phrases.
CRYPTO_PAYMENTS_ENABLED=false
# Automatic chain scan cadence. Minimum supported value is 15000 ms.
CRYPTO_PAYMENT_SCAN_INTERVAL_MS=60000
# Maximum time for one blockchain RPC/indexer HTTP request.
CRYPTO_PAYMENT_REQUEST_TIMEOUT_MS=10000
# Reserve the last 4 of six USDT decimal places for collision-safe invoice amounts.
# With the default, a quoted 20.00 USDT becomes 20.000001..20.009999.
CRYPTO_PAYMENT_AMOUNT_DISCRIMINATOR_DIGITS=4
# Do not reuse a completed/expired amount immediately; protects against late transfers.
CRYPTO_PAYMENT_AMOUNT_REUSE_DELAY_MS=86400000

# USDT on BNB Smart Chain (BSC)
CRYPTO_USDT_BSC_ENABLED=false
CRYPTO_USDT_BSC_RPC_URL=
CRYPTO_USDT_BSC_RECEIVING_ADDRESS=
# BNB Chain's widely used USDT representation. The backend allowlists this exact contract.
CRYPTO_USDT_BSC_TOKEN_IDENTIFIER=0x55d398326f99059ff775485246999027b3197955
CRYPTO_USDT_BSC_CONFIRMATIONS=1
CRYPTO_USDT_BSC_MAX_BLOCKS_PER_SCAN=1000

# USDT on Ethereum
CRYPTO_USDT_ETHEREUM_ENABLED=false
CRYPTO_USDT_ETHEREUM_RPC_URL=
CRYPTO_USDT_ETHEREUM_RECEIVING_ADDRESS=
# Canonical Tether USD₮ ERC-20 contract.
CRYPTO_USDT_ETHEREUM_TOKEN_IDENTIFIER=0xdac17f958d2ee523a2206206994597c13d831ec7
CRYPTO_USDT_ETHEREUM_CONFIRMATIONS=1
CRYPTO_USDT_ETHEREUM_MAX_BLOCKS_PER_SCAN=1000

# USDT on TON
CRYPTO_USDT_TON_ENABLED=false
# TON_RPC_URL should be a TON Center-compatible API host, for example https://toncenter.com.
CRYPTO_USDT_TON_RPC_URL=
# Optional hosted TON Center API credential. Keep it server-side.
CRYPTO_USDT_TON_API_KEY=
CRYPTO_USDT_TON_RECEIVING_ADDRESS=
# Canonical Tether USD₮ Jetton master.
CRYPTO_USDT_TON_TOKEN_IDENTIFIER=EQCxE6mUtQJKFnGfaROTKOt1lZbDiiX1kCixRv7Nw2Id_sDs
CRYPTO_USDT_TON_CONFIRMATIONS=1
CRYPTO_USDT_TON_MAX_BLOCKS_PER_SCAN=1000
