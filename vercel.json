{
  "$schema": "https://openapi.vercel.sh/vercel.json",
  "redirects": [
    {
      "source": "/:path*",
      "has": [
        {
          "type": "host",
          "value": "tgreposter.com"
        }
      ],
      "destination": "https://www.tgreposter.com/:path*",
      "permanent": true
    }
  ],
  "rewrites": [
    {
      "source": "/prototype/inbox",
      "destination": "/index.html"
    },
    {
      "source": "/dashboard/",
      "destination": "/index.html"
    },
    {
      "source": "/dashboard/:path*",
      "destination": "/index.html"
    },
    {
      "source": "/api/:path*",
      "destination": "https://api.tgreposter.com/api/:path*"
    }
  ]
}
